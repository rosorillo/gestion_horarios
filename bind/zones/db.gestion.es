$TTL 86400
@ IN SOA ns1.gestion-profes.es. root.daw.es. (
    2026022201 ; Serial (YYYYMMDDNN)
    3600       ; Refresh
    1800       ; Retry
    1209600    ; Expire
    86400 )    ; Minimum TTL
;
@       IN  NS  ns1.gestion-profes.es.
ns1     IN  A   172.20.0.53
@       IN  A   127.0.0.1
www     IN  A   127.0.0.1
